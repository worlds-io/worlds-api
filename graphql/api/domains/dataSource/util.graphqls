"""
A `DataSourceConnection` is the paginated results of a `data sources` query.
See [about queries](/guides/types/#queries) for details on how "connection" and "edge" types are used with pagination.
"""
type DataSourceConnection {
    """Pagination information for the resulting edges."""
    pageInfo: PageInfo!
    """The resulting collection of detection edges."""
    edges: [DataSourceEdge]!
    """The total count of data sources matching the query, across all pages."""
    totalCount: Int!
}

"""
A data source edge is the pairing of a Data Source with its query cursor.
See [about queries](/guides/types/#queries) for details on how "connection" and "edge" types are used with pagination.
"""
type DataSourceEdge {
    """
    Information about a particular Data Source.
    """
    node: DataSource
    """
    The cursor to use with the `dataSources` query `after` argument.
    """
    cursor: String!
}