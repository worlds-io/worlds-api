"""
A `ImageConnection` is the paginated results of a `images` query.
See [about queries](/guides/types/#queries) for details on how "connection" and "edge" types are used with pagination.
"""
type ImageConnection {
    """Pagination information for the resulting edges."""
    pageInfo: PageInfo!
    """The resulting collection of detection edges."""
    edges: [ImageEdge]!
    """The total count of images matching the query, across all pages."""
    totalCount: Int!
}

"""
A image edge is the pairing of a Image with its query cursor.
See [about queries](/guides/types/#queries) for details on how "connection" and "edge" types are used with pagination.
"""
type ImageEdge {
    """
    Information about a particular Image.
    """
    node: Image
    """
    The cursor to use with the `images` query `after` argument.
    """
    cursor: String!
}