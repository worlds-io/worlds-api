"""A page of [WorldModelNodes]({{Types.WorldModelNode}})."""
type WorldModelNodeConnection @experimental {
    """Pagination information for the resulting edges."""
    pageInfo: PageInfo!
    """The resulting page of nodes. (Pagination edges, not World Model edges.)"""
    edges: [WorldModelNodeConnectionEdge]!
    """The total count of nodes matching the query, across all pages."""
    totalCount: Int!
}

"""One entry of a [WorldModelNodeConnection]({{Types.WorldModelNodeConnection}})."""
type WorldModelNodeConnectionEdge @experimental {
    """The node."""
    node: WorldModelNode
    """The cursor to use with the [worldModelNodes query]({{Queries.worldModelNodes}}) `after` argument."""
    cursor: String!
}
