"""A page of WorldModelNodes."""
type WorldModelNodeConnection @experimental(reason: "World Model surface; may change without the usual deprecation window.") {
    """Pagination information for the resulting edges."""
    pageInfo: PageInfo!
    """The resulting page of nodes. (Pagination edges, not World Model edges.)"""
    edges: [WorldModelNodeConnectionEdge]!
    """The total count of nodes matching the query, across all pages."""
    totalCount: Int!
}

"""One entry of a WorldModelNodeConnection."""
type WorldModelNodeConnectionEdge @experimental(reason: "World Model surface; may change without the usual deprecation window.") {
    """The node."""
    node: WorldModelNode
    """The cursor to use with the worldModelNodes query `after` argument."""
    cursor: String!
}
