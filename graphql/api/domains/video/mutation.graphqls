extend type Mutation {
    clip(
        """Arguments to create a video clip from a data source."""
        input: CreateClipInput!
        """Optional IDs for events to associate with the clip."""
        eventIds: [ID!]
        """Optional IDs for activity chronicles to associate with the clip."""
        activityChronicleIds: [ID!]
    ): DataSourceClip
    """
    Requests that the edge holding a video's footage copy it to the hub.

    Track progress on `Video.sync`.
    """
    requestVideoSync(
        """The unique identifier of the video to sync."""
        id: ID!
    ): Video
    """
    Requests that a video's footage be kept past the standard retention window.

    The copy into retained storage runs after the mutation returns; track it on `Video.retained`.
    Fails for a video that is still recording, for footage that is still only on its edge
    (`requestVideoSync` brings it to the hub and retains it), and while retention is switched off.
    """
    retainVideo(
        """The unique identifier of the video to retain."""
        id: ID!
    ): Video
}