extend type Mutation {
    clip(
        """Arguments to create a video clip from a data source."""
        input: CreateClipInput!
        """Optional IDs for [events]({{Types.Event}}) to associate with the clip."""
        eventIds: [ID!]
        """Optional IDs for [activity chronicles]({{Types.ActivityChronicle}}) to associate with the clip."""
        activityChronicleIds: [ID!]
    ): DataSourceClip
    """
    Requests that the edge holding this [video]({{Types.Video}})'s footage copy it up to the hub, so that
    the footage becomes cloud-available.

    Status of the sync can be seen on [`Video.sync`]({{Types.VideoSync}}).
    """
    requestVideoSync(
        """The unique identifier of the video to sync."""
        id: ID!
    ): Video
}