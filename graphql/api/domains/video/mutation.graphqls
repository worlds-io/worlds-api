extend type Mutation {
    clip(
        """Arguments to create a video clip from a data source."""
        input: CreateClipInput!
        """Optional IDs for events to associate with the clip."""
        eventIds: [ID!]
        """Optional IDs for activity chronicles to associate with the clip."""
        activityChronicleIds: [ID!]
    ): DataSourceClip
    """
    Requests that the edge holding a video's footage copy it to the hub.

    Track progress on `Video.sync`.
    """
    requestVideoSync(
        """The unique identifier of the video to sync."""
        id: ID!
    ): Video
}