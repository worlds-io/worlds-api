"""
A video represents a video from a data source, including its start and end time.
"""
type Video {
    """The unique identifier for the video."""
    id: ID!
    """The data source that created the video."""
    dataSource: DataSource!
    """The time at which the video started."""
    startTime: DateTimeOffset!
    """
    The time at which the video ended. If not provided, the video is still ongoing.
    """
    endTime: DateTimeOffset
    """Whether the video's footage has been synced to the hub. `false` while it is still edge-only."""
    cloudAvailable: Boolean!
    """The state of syncing this video's footage from its edge to the hub."""
    sync: VideoSync!
    """The signed URL to be used to stream the video."""
    url: String!
    """The signed URL to be used to retrieve the video thumbnail."""
    thumbnailUrl: String
    """The display name of the video."""
    displayName: String
    """The resolution height of the video."""
    resolutionHeight: String
    """The resolution width of the video."""
    resolutionWidth: String
    """The frame rate of the video."""
    frameRate: Float
    """The user the video was created by."""
    createdBy: User
}

"""
The state of copying a [video]({{Types.Video}})'s footage from its edge to the hub.

To check whether the footage is on the hub, use [`Video.cloudAvailable`]({{Types.Video}}).
"""
type VideoSync {
    """The state of the video's sync."""
    state: VideoSyncState!
    """The number of video segments copied so far. Null until the edge reports progress."""
    segmentsDone: Int
    """The number of video segments to be copied. Null until the edge reports progress."""
    segmentsTotal: Int
    """The number of times the request has been sent to the edge."""
    attempts: Int!
    """
    The time at which the sync last reported progress. Null when no sync has been requested. An old value
    on an active state means the sync may have stalled.
    """
    lastEventAt: DateTimeOffset
    """The reason the sync failed, when it did."""
    error: String
}

"""
The state of a [video sync]({{Types.VideoSync}}).

Also covers videos with no sync request, so a caller can tell whether to offer one.
"""
enum VideoSyncState {
    """The video cannot be synced. Its device has no site, or its site has no edge."""
    NOT_SYNCABLE
    """Still recording and not yet being synced."""
    RECORDING
    """Finished recording but not requested for sync."""
    NOT_REQUESTED
    """Sync has been requested from the edge."""
    REQUESTED
    """The edge has acknowledged the request but has not started copying."""
    ACCEPTED
    """The edge is copying the video's footage to the hub."""
    IN_PROGRESS
    """Recording with live sync, so the video is already cloud-available."""
    LIVE
    """The video's footage has been copied to the hub."""
    SUCCEEDED
    """The sync failed. See [`VideoSync.error`]({{Types.VideoSync}})."""
    FAILED
    """A cancel has been requested."""
    CANCELLING
    """The sync was cancelled before it completed."""
    CANCELLED
}