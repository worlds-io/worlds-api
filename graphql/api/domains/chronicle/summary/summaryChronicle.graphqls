"""
A summary chronicle summarizes across a specific timeframe.  It can reference event and activity chronicles.
"""
type SummaryChronicle {
    """The unique identifier for the summary."""
    id: ID!
    """The name of the summary"""
    name: String!
    """The chronicle producer that created the summary."""
    chronicleProducer: ChronicleProducer!
    """A text description of the summary."""
    description: String
    """The start time of the summary."""
    startTime: DateTimeOffset!
    """The end time of the summary."""
    endTime: DateTimeOffset!
    """The timezone for the summary, if provided."""
    timezone: String
    """Additional metadata associated with the summary. This may represent any JSON object structure."""
    metadata: JSON
    """Optional information to validate the accuracy of the summary."""
    validation: ChronicleValidation
    """User-defined priority of the summary."""
    priority: String
    """User-defined status of the summary."""
    status: String
    """Human-readable labels describing the summary."""
    labels: [String!]
    """Human-readable locations describing the summary."""
    locations: [String!]
    """Activity chronicles associated with the summary."""
    activityChronicles: [ActivityChronicle!]!
    """Event chronicles associated with the summary."""
    eventChronicles: [EventChronicle!]!
    """
    Sites associated with the summary. A user needs access to at least one site to view the summary.
    A summary with no sites is visible only to administrators.
    """
    sites: [Site!]!
    """Timestamp that the summary was created."""
    createdAt: DateTimeOffset!
    """Timestamp that the summary was most recently updated."""
    updatedAt: DateTimeOffset!
}

"""
This input type is used to create a new `SummaryChronicle`.
"""
input CreateSummaryChronicleInput {
    """The name of the summary"""
    name: String!
    """The summary producer that owns the summary."""
    chronicleProducerId: ID!
    """A text description of the summary."""
    description: String
    """The start time of the summary."""
    startTime: DateTimeOffset!
    """The end time of the summary."""
    endTime: DateTimeOffset!
    """The timezone for the summary, if provided."""
    timezone: String
    """Additional metadata associated with the summary. This may represent any JSON object structure."""
    metadata: JSON
    """User-defined priority of the summary."""
    priority: String
    """User-defined status of the summary."""
    status: String
    """Human-readable labels describing the summary."""
    labels: [String!]
    """Human-readable locations describing the summary."""
    locations: [String!]
    """Optional information to validate the accuracy of the summary."""
    validation: ChronicleValidationInput
    """IDs of activity chronicles associated with the summary."""
    activityChronicleIds: [ID!]
    """IDs of event chronicles associated with the summary."""
    eventChronicleIds: [ID!]
    """
    IDs of sites associated with the summary. Required, with at least one site you can access, unless you are an
    administrator.
    """
    siteIds: [ID!]
}

"""
This input type is used to update an existing `SummaryChronicle`.
"""
input UpdateSummaryChronicleInput {
    """The unique identifier for the summary."""
    id: ID!
    """The name of the summary"""
    name: String
    """A text description of the summary."""
    description: String
    """The start time of the summary."""
    startTime: DateTimeOffset
    """The end time of the summary."""
    endTime: DateTimeOffset
    """The timezone for the summary, if provided."""
    timezone: String
    """Additional metadata associated with the summary. This may represent any JSON object structure."""
    metadata: JSON @deprecated(reason: "Use `metadataUpdate: { replace }` instead.")
    """How this update changes `metadata`. `null` clears it. Cannot be combined with `metadata`."""
    metadataUpdate: JSONUpdateInput
    """User-defined priority of the summary."""
    priority: String
    """User-defined status of the summary."""
    status: String
    """Human-readable labels describing the summary."""
    labels: [String!] @deprecated(reason: "Use `labelsUpdate: { replace }` instead.")
    """How this update changes `labels`. `null` clears it. Cannot be combined with `labels`."""
    labelsUpdate: StringListUpdateInput
    """Human-readable locations describing the summary."""
    locations: [String!] @deprecated(reason: "Use `locationsUpdate: { replace }` instead.")
    """How this update changes `locations`. `null` clears it. Cannot be combined with `locations`."""
    locationsUpdate: StringListUpdateInput
    """Optional information to validate the accuracy of the summary."""
    validation: ChronicleValidationInput
    """IDs of activity chronicles associated with the summary."""
    activityChronicleIds: [ID!] @deprecated(reason: "Use `activityChronicleIdsUpdate: { replace }` instead.")
    """
    How this update changes the summary's activity chronicles. `null` removes every one you can read.
    Cannot be combined with `activityChronicleIds`.
    """
    activityChronicleIdsUpdate: IDListUpdateInput
    """IDs of event chronicles associated with the summary."""
    eventChronicleIds: [ID!] @deprecated(reason: "Use `eventChronicleIdsUpdate: { replace }` instead.")
    """
    How this update changes the summary's event chronicles. `null` removes every one you can read.
    Cannot be combined with `eventChronicleIds`.
    """
    eventChronicleIdsUpdate: IDListUpdateInput
    """
    How this update changes the summary's sites. `null` removes every one you can access. Sites you cannot access are
    kept. Unless you are an administrator, the summary must keep at least one site you can access.
    """
    siteIdsUpdate: IDListUpdateInput
}