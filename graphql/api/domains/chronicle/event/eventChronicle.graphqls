"""
An event chronicle represents an occurrence at a single point at time.
"""
type EventChronicle {
    """The unique identifier for the event."""
    id: ID!
    """The chronicle producer that created the event."""
    chronicleProducer: ChronicleProducer!
    """The name of the event"""
    name: String!
    """A text description of the event."""
    description: String
    """The time at which the event occurred."""
    timestamp: DateTimeOffset!
    """The timezone for the event, if provided."""
    timezone: String
    """Additional metadata associated with the event. This may represent any JSON object structure."""
    metadata: JSON
    """Optional information to validate the accuracy of the event."""
    validation: ChronicleValidation
    """User-defined priority of the event."""
    priority: String
    """User-defined status of the event."""
    status: String
    """Human-readable labels describing the event."""
    labels: [String!]
    """Human-readable locations describing the event."""
    locations: [String!]
    """Activity chronicles associated with the event."""
    activityChronicles: [ActivityChronicle!]!
    """
    Sites associated with the event. A user restricted to sites sees the event only if they can access one of these.
    An event with no sites is company-wide and visible only to administrators.
    """
    sites: [Site!]!
    """Timestamp that the event was created."""
    createdAt: DateTimeOffset!
    """Timestamp that the event was most recently updated."""
    updatedAt: DateTimeOffset!
}

"""
This input type is used to create a new `EventChronicle`.
"""
input CreateEventChronicleInput {
    """The name of the event"""
    name: String!
    """The event producer that owns the event."""
    chronicleProducerId: ID!
    """A text description of the event."""
    description: String
    """The time at which the event occurred."""
    timestamp: DateTimeOffset!
    """The timezone for the event, if provided."""
    timezone: String
    """Additional metadata associated with the event. This may represent any JSON object structure."""
    metadata: JSON
    """User-defined priority of the event."""
    priority: String
    """User-defined status of the event."""
    status: String
    """Human-readable labels describing the event."""
    labels: [String!]
    """Human-readable locations describing the event."""
    locations: [String!]
    """Optional information to validate the accuracy of the event."""
    validation: ChronicleValidationInput
    """IDs of activity chronicles associated with the event."""
    activityChronicleIds: [ID!]
    """
    IDs of sites associated with the event. Required, with at least one site you can access, unless you are an
    administrator.
    """
    siteIds: [ID!]
}

"""
This input type is used to update an existing `EventChronicle`.
"""
input UpdateEventChronicleInput {
    """The unique identifier for the event."""
    id: ID!
    """The name of the event"""
    name: String
    """A text description of the event."""
    description: String
    """The time at which the event occurred."""
    timestamp: DateTimeOffset
    """The timezone for the event, if provided."""
    timezone: String
    """Additional metadata associated with the event. This may represent any JSON object structure."""
    metadata: JSON @deprecated(reason: "Use `metadataUpdate: { replace }` instead.")
    """How this update changes `metadata`. `null` clears it. Cannot be combined with `metadata`."""
    metadataUpdate: JSONUpdateInput
    """User-defined priority of the event."""
    priority: String
    """User-defined status of the event."""
    status: String
    """Human-readable labels describing the event."""
    labels: [String!] @deprecated(reason: "Use `labelsUpdate: { replace }` instead.")
    """How this update changes `labels`. `null` clears it. Cannot be combined with `labels`."""
    labelsUpdate: StringListUpdateInput
    """Human-readable locations describing the event."""
    locations: [String!] @deprecated(reason: "Use `locationsUpdate: { replace }` instead.")
    """How this update changes `locations`. `null` clears it. Cannot be combined with `locations`."""
    locationsUpdate: StringListUpdateInput
    """Optional information to validate the accuracy of the event."""
    validation: ChronicleValidationInput
    """IDs of activity chronicles associated with the event."""
    activityChronicleIds: [ID!]
    """
    How this update changes the event's sites. `null` removes every one you can access. Sites you cannot access are
    kept. Unless you are an administrator, the event must keep at least one site you can access.
    """
    siteIdsUpdate: IDListUpdateInput
}