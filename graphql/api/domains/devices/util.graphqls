"""
A `DeviceConnection` is the paginated results of a `devices` query.
See [about queries](/guides/types/#queries) for details on how "connection" and "edge" types are used with pagination.
"""
type DeviceConnection {
    """Pagination information for the resulting edges."""
    pageInfo: PageInfo!
    """The resulting collection of Device edges."""
    edges: [DeviceEdge]!
    """The total count of devices matching the query, across all pages."""
    totalCount: Int!
}

"""
A device edge is the pairing of a Device with its query cursor.
See [about queries](/guides/types/#queries) for details on how "connection" and "edge" types are used with pagination.
"""
type DeviceEdge {
    """Information about a particular Device."""
    node: Device
    """
    The cursor to use with the Query `devices` field `after` argument.
    """
    cursor: String!
}